# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex key used to encrypt OAuth tokens and AI provider keys at rest. Generate with: npm run gen:key
TOKEN_ENCRYPTION_KEY=

# Optional: comma-separated emails that are always administrators (the first user to sign up is admin automatically)
ADMIN_EMAILS=

# ---------- Google (Gmail + Google Calendar) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Enable: Gmail API, Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Microsoft (Outlook Mail + Calendar via Microsoft Graph) ----------
# Azure Portal -> App registrations -> Redirect URI (Web): ${NEXT_PUBLIC_APP_URL}/api/auth/microsoft/callback
# Delegated permissions: openid, profile, email, offline_access, User.Read, Mail.ReadWrite, Mail.Send, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows personal + work/school accounts. Use "consumers" or a tenant id to restrict.
MICROSOFT_TENANT=common

# ---------- AI (Anthropic) ----------
ANTHROPIC_API_KEY=
# Model used for the assistant and email analysis. Override e.g. with claude-sonnet-5 for cheaper bulk analysis.
AI_MODEL=claude-opus-5
AI_ANALYSIS_MODEL=claude-opus-5
# Automatically analyze new emails during sync (true/false) and how many per sync run
AI_AUTO_ANALYZE=true
AI_AUTO_ANALYZE_LIMIT=10

# ---------- Sync ----------
# Messages fetched per sync run per mailbox. Keep modest so runs finish within the serverless
# time limit (Vercel Hobby: 60s). Raise on Pro plans together with maxDuration in the sync routes.
INITIAL_SYNC_DAYS=30
MAX_MESSAGES_PER_SYNC=100
# Secret used by the scheduled sync endpoint (/api/cron/sync). Generate with: npm run gen:key
CRON_SECRET=
